---
import CoordinateMarker from '@/components/CoordinateMarker.astro';
import Wordmark from '@/components/Wordmark.astro';
import { useTranslations, type Locale } from '@/i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const rights = t.footer.rights.replace('{year}', String(year));
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <Wordmark locale={locale} size="compact" />
      <CoordinateMarker label={t.footer.location} coordinates={t.footer.coordinates} variant="block" />
    </div>

    <div class="footer__quote mono">{t.footer.builtIn}</div>

    <div class="footer__bottom">
      <span class="footer__rights mono">{rights}</span>
      <ul class="footer__links">
        <li>
          <a href="https://github.com/jearl4" target="_blank" rel="noopener noreferrer" class="mono">
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/john-t-earl-114a1563/"
            target="_blank"
            rel="noopener noreferrer"
            class="mono"
          >
            LinkedIn
          </a>
        </li>
        <li><a href="mailto:dev@waycrosslabs.com" class="mono">dev@</a></li>
        <li><a href="mailto:support@waycrosslabs.com" class="mono">support@</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    padding-block: clamp(var(--space-12), 8vw, var(--space-24));
    background: var(--paper-shade);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .footer__quote {
    color: var(--clay);
    letter-spacing: 0.18em;
    font-size: var(--t-xs);
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer__rights {
    color: var(--ink-faint);
    font-size: 0.7rem;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer__links a {
    color: var(--ink-soft);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .footer__links a:hover {
    color: var(--clay);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .footer__top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
