---
import ContactCard from '@/components/ContactCard.astro';
import { useTranslations, type Locale } from '@/i18n/index';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="contact section" id="contact" aria-labelledby="contact-heading">
  <div class="container contact__grid">
    <div class="contact__label">
      <div class="eyebrow">{t.contact.eyebrow}</div>
      <div class="contact__index mono">§ 04</div>
    </div>

    <div class="contact__content">
      <h2 class="contact__heading" id="contact-heading">{t.contact.heading}</h2>
      <p class="contact__body">{t.contact.body}</p>

      <div class="contact__cards">
        <ContactCard
          variant="dev"
          title={t.contact.devTitle}
          email={t.contact.devEmail}
          useFor={t.contact.devUseFor}
          cta={t.contact.devCta}
        />
        <ContactCard
          variant="support"
          title={t.contact.supportTitle}
          email={t.contact.supportEmail}
          useFor={t.contact.supportUseFor}
          cta={t.contact.supportCta}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 3fr);
    gap: clamp(var(--space-8), 6vw, var(--space-20));
    align-items: start;
  }

  .contact__label {
    position: sticky;
    top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__index {
    color: var(--ink-faint);
    letter-spacing: 0.18em;
    font-size: var(--t-xs);
  }

  .contact__heading {
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
    max-width: 16ch;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 0,
      'WONK' 1;
  }

  .contact__body {
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    max-width: 56ch;
    margin-bottom: var(--space-12);
  }

  .contact__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--space-4), 2vw, var(--space-8));
  }

  @media (max-width: 768px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__label {
      position: static;
    }
    .contact__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
