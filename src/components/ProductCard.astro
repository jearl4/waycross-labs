---
import { useTranslations, type Locale } from '@/i18n/index';
import type { Product } from '@/content/products';

interface Props {
  product: Product;
  locale: Locale;
  index: number;
}

const { product, locale, index } = Astro.props;
const t = useTranslations(locale);
const copy = t.products[product.copyKey];
const accentVar = `var(--${product.accent})`;
const idx = String(index + 1).padStart(2, '0');
---

<article class="product" style={`--product-accent: ${accentVar};`}>
  <header class="product__head">
    <div class="product__index mono">{idx}</div>
    <div class="product__status">
      <span class="product__status-dot" aria-hidden="true"></span>
      <span class="mono">{copy.statusLabel}</span>
    </div>
  </header>

  <div class="product__body">
    <h3 class="product__name">{product.name}</h3>
    <p class="product__tagline">{copy.tagline}</p>
    <p class="product__desc">{copy.description}</p>

    <ul class="product__features">
      {copy.featureList.map((feature) => (
        <li>
          <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
            <path d="M2 6 L5 9 L10 3" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>

  <footer class="product__foot">
    <a class="product__cta" href={product.url} target="_blank" rel="noopener">
      <span>{copy.cta}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M5 12 H19 M13 6 L19 12 L13 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
    <span class="product__url mono">{new URL(product.url).host}</span>
  </footer>
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-shade) 100%);
    padding: clamp(var(--space-8), 4vw, var(--space-16));
    position: relative;
    transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .product::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--product-accent);
    transition: width var(--dur-base) var(--ease);
  }

  .product:hover {
    border-color: var(--product-accent);
  }

  .product:hover::before {
    width: 8px;
  }

  .product__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-8);
  }

  .product__index {
    color: var(--ink-faint);
    letter-spacing: 0.18em;
  }

  .product__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--pine);
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
  }

  .product__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--pine);
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--pine) 18%, transparent);
  }

  .product__body {
    flex: 1;
  }

  .product__name {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-3) 0;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 0,
      'WONK' 1;
  }

  .product__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: var(--product-accent);
    max-width: 32ch;
    margin: 0 0 var(--space-6) 0;
    font-variation-settings:
      'opsz' 24,
      'SOFT' 100;
  }

  .product__desc {
    color: var(--ink-soft);
    font-size: var(--t-md);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0 0 var(--space-8) 0;
  }

  .product__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3) var(--space-6);
  }

  .product__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--t-sm);
    color: var(--ink);
  }

  .product__features svg {
    color: var(--product-accent);
    margin-top: 0.4rem;
    flex-shrink: 0;
  }

  .product__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .product__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-1);
    transition: color var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
    text-decoration: none;
    font-variation-settings:
      'opsz' 24,
      'SOFT' 100;
  }

  .product__cta:hover {
    color: var(--product-accent);
    border-bottom-color: var(--product-accent);
    text-decoration: none;
  }

  .product__cta svg {
    transition: transform var(--dur-base) var(--ease);
  }

  .product__cta:hover svg {
    transform: translateX(0.35rem);
  }

  .product__url {
    color: var(--ink-faint);
  }
</style>
