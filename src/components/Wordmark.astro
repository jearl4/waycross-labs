---
import { useTranslations, type Locale } from '@/i18n/index';

interface Props {
  locale: Locale;
  /** When true, renders the wordmark as the page <h1>. Otherwise as a decorative <div>. */
  asH1?: boolean;
  size?: 'hero' | 'compact';
}

const { locale, asH1 = false, size = 'hero' } = Astro.props;
const t = useTranslations(locale);
const Tag = asH1 ? 'h1' : 'div';
---

<Tag class={`wordmark wordmark--${size}`} aria-label={`${t.hero.wordmarkTop} ${t.hero.wordmarkBottom}`}>
  <span class="wordmark__line wordmark__line--top">{t.hero.wordmarkTop}</span>
  <span class="wordmark__rule" aria-hidden="true">
    <svg viewBox="0 0 200 12" preserveAspectRatio="none" focusable="false">
      <line x1="0" y1="6" x2="200" y2="6" stroke="currentColor" stroke-width="2" />
      <circle cx="100" cy="6" r="3" fill="currentColor" />
    </svg>
  </span>
  <span class="wordmark__line wordmark__line--bottom">{t.hero.wordmarkBottom}</span>
  {size === 'hero' && (
    <span class="wordmark__establishment mono">{t.hero.establishment}</span>
  )}
</Tag>

<style>
  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin: 0;
    text-align: center;
    color: var(--ink);
  }

  .wordmark__line {
    font-family: var(--font-display);
    letter-spacing: -0.05em;
    font-weight: 400;
    text-transform: uppercase;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 0,
      'WONK' 1;
  }

  .wordmark--hero .wordmark__line {
    font-size: clamp(4.5rem, 18vw, 14rem);
    line-height: 0.85;
  }

  .wordmark--compact .wordmark__line {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1;
  }

  .wordmark--hero .wordmark__line--top {
    transform: translateX(-0.04em);
  }

  .wordmark--hero .wordmark__line--bottom {
    transform: translateX(0.04em);
  }

  .wordmark__rule {
    display: block;
    color: var(--clay);
  }

  .wordmark__rule svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .wordmark--hero .wordmark__rule {
    width: clamp(6rem, 30vw, 22rem);
    height: 0.5rem;
    margin-block: clamp(-0.5rem, -1vw, -0.25rem);
  }

  .wordmark--compact .wordmark__rule {
    width: 3rem;
    height: 0.4rem;
    margin-block: var(--space-2);
  }

  .wordmark__establishment {
    margin-top: var(--space-6);
    font-size: var(--t-xs);
    letter-spacing: 0.22em;
    color: var(--ink-soft);
  }
</style>
