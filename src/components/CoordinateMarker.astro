---
interface Props {
  /** location label, e.g. "Charlotte, NC · 28214" */
  label: string;
  /** coordinates, e.g. "35.2914° N · 80.9659° W" */
  coordinates: string;
  variant?: 'inline' | 'block';
}

const { label, coordinates, variant = 'inline' } = Astro.props;
---

<div class={`coord coord--${variant}`}>
  <span class="coord__crosshair" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="22" height="22">
      <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1" />
      <circle cx="16" cy="16" r="2" fill="currentColor" />
      <line x1="16" y1="0" x2="16" y2="6" stroke="currentColor" stroke-width="1" />
      <line x1="16" y1="26" x2="16" y2="32" stroke="currentColor" stroke-width="1" />
      <line x1="0" y1="16" x2="6" y2="16" stroke="currentColor" stroke-width="1" />
      <line x1="26" y1="16" x2="32" y2="16" stroke="currentColor" stroke-width="1" />
    </svg>
  </span>
  <div class="coord__text">
    <span class="coord__label mono">{label}</span>
    <span class="coord__coords mono">{coordinates}</span>
  </div>
</div>

<style>
  .coord {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-soft);
  }

  .coord--block {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .coord__crosshair {
    color: var(--clay);
    flex-shrink: 0;
  }

  .coord__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .coord__label {
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    color: var(--ink);
  }

  .coord__coords {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    text-transform: none;
  }
</style>
