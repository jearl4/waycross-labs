---
import LocaleSwitcher from '@/components/LocaleSwitcher.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { useTranslations, type Locale } from '@/i18n/index';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const navLinks = [
  { href: '#about', label: t.nav.about },
  { href: '#founder', label: t.nav.founder },
  { href: '#products', label: t.nav.products },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__brand mono" href={locale === 'en' ? '/' : '/es/'}>
      <span class="header__brand-mark" aria-hidden="true">▲</span>
      <span>Waycross Labs</span>
    </a>
    <nav class="header__nav" aria-label={t.nav.primaryLabel}>
      {navLinks.map((link) => (
        <a href={link.href} class="header__link mono">{link.label}</a>
      ))}
    </nav>
    <div class="header__controls">
      <LocaleSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
      <button
        type="button"
        class="header__menu-btn"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <span class="header__menu-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
            <path class="header__menu-line header__menu-line--top" d="M3 7 H21" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            <path class="header__menu-line header__menu-line--mid" d="M3 12 H21" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            <path class="header__menu-line header__menu-line--bot" d="M3 17 H21" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </span>
      </button>
    </div>
  </div>
  <nav
    id="mobile-nav"
    class="header__mobile-nav"
    aria-label={t.nav.primaryLabel}
    data-mobile-nav
    hidden
  >
    <ul class="header__mobile-list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="header__mobile-link mono" data-mobile-link>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding-block: var(--space-4);
    background-color: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease);
  }

  .header[data-scrolled='true'] {
    border-bottom-color: var(--rule);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-decoration: none;
    justify-self: start;
  }

  .header__brand:hover {
    color: var(--clay);
    text-decoration: none;
  }

  .header__brand-mark {
    color: var(--clay);
    font-size: 0.6rem;
    transform: translateY(-1px);
  }

  .header__nav {
    display: inline-flex;
    gap: var(--space-6);
    justify-self: center;
  }

  .header__link {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--t-xs);
    letter-spacing: 0.16em;
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .header__link:hover {
    color: var(--clay);
    border-bottom-color: var(--clay);
    text-decoration: none;
  }

  .header__controls {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
    justify-self: end;
  }

  .header__menu-btn {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    color: var(--ink);
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .header__menu-btn:hover {
    border-color: var(--clay);
    color: var(--clay);
  }

  .header__menu-line {
    transition:
      transform var(--dur-base) var(--ease),
      opacity var(--dur-base) var(--ease);
    transform-origin: center;
  }

  .header__menu-btn[aria-expanded='true'] .header__menu-line--top {
    transform: translateY(5px) rotate(45deg);
  }

  .header__menu-btn[aria-expanded='true'] .header__menu-line--mid {
    opacity: 0;
  }

  .header__menu-btn[aria-expanded='true'] .header__menu-line--bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  .header__mobile-nav {
    background: var(--paper);
    border-top: 1px solid var(--rule-strong);
    padding-block: var(--space-4);
  }

  .header__mobile-nav[hidden] {
    display: none;
  }

  .header__mobile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-4) clamp(var(--space-6), 5vw, var(--space-16));
    color: var(--ink);
    text-decoration: none;
    font-size: var(--t-sm);
    letter-spacing: 0.18em;
    border-bottom: 1px solid var(--rule);
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }

  .header__mobile-link:hover,
  .header__mobile-link:focus-visible {
    color: var(--clay);
    background: var(--paper-shade);
    text-decoration: none;
  }

  .header__mobile-list li:last-child .header__mobile-link {
    border-bottom: 0;
  }

  @media (max-width: 768px) {
    .header__nav {
      display: none;
    }
    .header__inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
    .header__menu-btn {
      display: inline-flex;
    }
  }
</style>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-header]');
    if (!header) return;
    function onScroll() {
      header.dataset.scrolled = String(window.scrollY > 8);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    var btn = document.querySelector('[data-menu-toggle]');
    var panel = document.querySelector('[data-mobile-nav]');
    if (!btn || !panel) return;
    var links = panel.querySelectorAll('[data-mobile-link]');

    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute(
        'aria-label',
        open ? btn.dataset.labelClose : btn.dataset.labelOpen
      );
      if (open) {
        panel.removeAttribute('hidden');
        var first = panel.querySelector('a');
        if (first) first.focus();
      } else {
        panel.setAttribute('hidden', '');
      }
    }

    btn.addEventListener('click', function () {
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
      if (isOpen) btn.focus();
    });

    links.forEach(function (link) {
      link.addEventListener('click', function () {
        setOpen(false);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });

    var mql = window.matchMedia('(min-width: 769px)');
    function onResize(e) {
      if (e.matches && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    }
    if (typeof mql.addEventListener === 'function') {
      mql.addEventListener('change', onResize);
    } else if (typeof mql.addListener === 'function') {
      mql.addListener(onResize);
    }
  })();
</script>
