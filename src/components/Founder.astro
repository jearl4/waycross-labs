---
import { useTranslations, type Locale } from '@/i18n/index';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const GITHUB_URL = 'https://github.com/jearl4';
const LINKEDIN_URL = 'https://www.linkedin.com/in/john-t-earl-114a1563/';
---

<section class="founder section" id="founder" aria-labelledby="founder-heading">
  <div class="container founder__grid">
    <div class="founder__label">
      <div class="eyebrow">{t.founder.eyebrow}</div>
      <div class="founder__index mono">§ 02</div>
    </div>

    <div class="founder__content">
      <div class="founder__name-block">
        <h2 class="founder__name" id="founder-heading">{t.founder.nameDisplay}</h2>
        <span class="founder__longname mono">{t.founder.nameLong}</span>
        <span class="founder__role">{t.founder.role}</span>
      </div>

      <p class="founder__body">{t.founder.body}</p>

      <div class="founder__details">
        <div class="founder__creds">
          <div class="founder__details-heading mono">{t.founder.credsHeading}</div>
          <ul class="founder__cred-list">
            <li>
              <svg class="founder__cred-mark" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false">
                <path d="M5 0 L10 5 L5 10 L0 5 Z" fill="currentColor" />
              </svg>
              <span class="mono">{t.founder.credAwsSa}</span>
            </li>
            <li>
              <svg class="founder__cred-mark" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false">
                <path d="M5 0 L10 5 L5 10 L0 5 Z" fill="currentColor" />
              </svg>
              <span class="mono">{t.founder.credAwsDev}</span>
            </li>
          </ul>
        </div>

        <div class="founder__socials">
          <div class="founder__details-heading mono">{t.founder.socialsHeading}</div>
          <ul class="founder__social-list">
            <li>
              <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
                <span class="mono">{t.founder.githubLabel}</span>
                <span class="founder__handle">@jearl4</span>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path d="M2 2 L14 2 L14 14 M14 2 L2 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </a>
            </li>
            <li>
              <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
                <span class="mono">{t.founder.linkedinLabel}</span>
                <span class="founder__handle">john-t-earl</span>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path d="M2 2 L14 2 L14 14 M14 2 L2 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder__grid {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 3fr);
    gap: clamp(var(--space-8), 6vw, var(--space-20));
    align-items: start;
  }

  .founder__label {
    position: sticky;
    top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .founder__index {
    color: var(--ink-faint);
    letter-spacing: 0.18em;
    font-size: var(--t-xs);
  }

  .founder__name-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-8);
  }

  .founder__name {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--ink);
    font-variation-settings:
      'opsz' 144,
      'SOFT' 0,
      'WONK' 1;
  }

  .founder__longname {
    color: var(--ink-faint);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    margin-top: var(--space-2);
  }

  .founder__role {
    color: var(--clay);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-md);
    margin-top: var(--space-3);
    font-variation-settings:
      'opsz' 24,
      'SOFT' 100;
  }

  .founder__body {
    font-size: clamp(1.125rem, 1.4vw, 1.375rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
    margin-bottom: var(--space-12);
  }

  .founder__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(var(--space-8), 4vw, var(--space-16));
    border-top: 1px solid var(--rule);
    padding-top: var(--space-8);
  }

  .founder__details-heading {
    font-size: var(--t-xs);
    letter-spacing: 0.22em;
    color: var(--ink-faint);
    margin-bottom: var(--space-4);
  }

  .founder__cred-list,
  .founder__social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .founder__cred-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    font-size: var(--t-sm);
  }

  .founder__cred-mark {
    color: var(--clay);
    font-size: 0.7rem;
  }

  .founder__social-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .founder__social-list a:hover {
    color: var(--clay);
    border-bottom-color: var(--clay);
  }

  .founder__social-list a .mono {
    color: var(--ink-soft);
    flex-shrink: 0;
    width: 5rem;
  }

  .founder__social-list a:hover .mono {
    color: var(--clay);
  }

  .founder__handle {
    flex: 1;
    font-family: var(--font-display);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .founder__grid {
      grid-template-columns: 1fr;
    }
    .founder__label {
      position: static;
    }
  }
</style>
